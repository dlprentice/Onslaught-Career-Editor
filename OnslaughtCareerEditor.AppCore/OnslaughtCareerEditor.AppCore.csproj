<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>OnslaughtCareerEditor.AppCore</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!--
      No debug symbols in published output: the AppCore PDB carries a SourceLink
      mapping with the build machine's username and path.
    -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <!-- The companion owns the file-safety source; the patch engine compiles the same file. -->
    <Compile Include="../companion/OnslaughtToolkit.Godot/Files/FileMutationSafety.cs" Link="Linked/FileMutationSafety.cs" />
  </ItemGroup>

</Project>
