<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RootNamespace>OnslaughtCareerEditor.WinUI</RootNamespace>
    <Version>1.0.10</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>false</EnableMsixTooling>
    <AppxPackage>false</AppxPackage>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Project-authored artwork; see tools/generate_app_icon.py for provenance. -->
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <!--
      Public identity. The ZIP probe and About page show these strings, and the
      release artifact must not carry the internal project name or a local
      SourceLink mapping (which embeds the build machine's username and path in
      PDB debug symbols). DebugType none keeps PDBs out of the shipped payload.
    -->
    <AssemblyTitle>Onslaught Toolkit</AssemblyTitle>
    <AssemblyProduct>Onslaught Toolkit</AssemblyProduct>
    <GenerateAssemblyCompanyAttribute>false</GenerateAssemblyCompanyAttribute>
    <AssemblyDescription>Preservation and safe-editing toolkit for Battle Engine Aquila saves, careers, and copies.</AssemblyDescription>
    <Company></Company>
    <Product>Onslaught Toolkit</Product>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibVLCSharp" Version="3.9.7.1" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.0.1" />
    <PackageReference Include="NAudio" Version="2.3.0" />
    <PackageReference Include="NAudio.Vorbis" Version="1.5.0" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.23.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OnslaughtCareerEditor.AppCore\OnslaughtCareerEditor.AppCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The WinUI targets glob Assets\** as Content, which would ship the icon's
      PNG preview. The release package's payload-safety check denies .png
      outside two SDK-owned prefixes, so shipping it would fail the ZIP probe.
      The preview is a convenience for humans reading the repo; only the .ico
      belongs in the build.
    -->
    <Content Remove="Assets\**\*.png" />
    <None Include="Assets\**\*.png" />
    <Content Include="Assets\AppIcon.ico" CopyToOutputDirectory="PreserveNewest" />
    <!--
      The two registered screenshots of the game, which the Home hero and the
      About page show. They ship: the ZIP probe allows images under
      app/assets/screenshots/ and denies them everywhere else, so this prefix is
      the whole allowance. AGENTS.md ("A screenshot is not an asset") states the
      rule; attribution.md registers these two files. Not Assets\Game - "game"
      is a denied path segment in the package probe, and rightly so.
    -->
    <Content Include="Assets\Screenshots\*.jpg" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\patches\catalog\patches.v2.json" Link="patches\catalog\patches.v2.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\patches\catalog\safe-copy-profiles.v1.json" Link="patches\catalog\safe-copy-profiles.v1.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CopyWinUIPriToPublishDirectory" AfterTargets="Publish" Condition="'$(PublishDir)' != ''">
    <ItemGroup>
      <_WinUIAppPri Include="$(TargetDir)$(AssemblyName).pri" Condition="Exists('$(TargetDir)$(AssemblyName).pri')" />
    </ItemGroup>
    <Copy SourceFiles="@(_WinUIAppPri)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyWinUINoticesToPublishDirectory" AfterTargets="Publish" Condition="'$(PublishDir)' != ''">
    <PropertyGroup>
      <_WinUINoticeSource>$(MSBuildProjectDirectory)\..\release\readiness\THIRD_PARTY_NOTICES.winui.md</_WinUINoticeSource>
    </PropertyGroup>
    <Copy SourceFiles="$(_WinUINoticeSource)" DestinationFiles="$(PublishDir)THIRD_PARTY_NOTICES.md" Condition="Exists('$(_WinUINoticeSource)')" SkipUnchangedFiles="true" />
  </Target>

</Project>
