<Page
    x:Class="OnslaughtCareerEditor.WinUI.Pages.LorePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:helpers="using:OnslaughtCareerEditor.WinUI.Helpers"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid Padding="20,18,20,20"
          RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Spacing="6">
            <TextBlock Text="Lore"
                       AutomationProperties.AutomationId="LorePageTitle"
                       AutomationProperties.HeadingLevel="Level1"
                       Style="{StaticResource SectionTitleTextStyle}" />
            <TextBlock Text="Explore Battle Engine Aquila's world, characters, development history, and preservation research."
                       Style="{StaticResource SectionBodyTextStyle}" />
            <TextBlock x:Name="LoreSourceBoundaryStatusTextBlock"
                       AutomationProperties.AutomationId="LoreSourceBoundaryStatus"
                       Text="Offline library: included document links stay here; Source and External links open in your browser."
                       Style="{StaticResource SectionBodyTextStyle}" />
            <StackPanel Visibility="Collapsed">
                <TextBlock x:Name="LibrarySummaryTextBlock"
                           Text="Loading lore library..." />
                <TextBlock x:Name="LibraryCountTextBlock"
                           Text="Preparing reader..." />
            </StackPanel>
        </StackPanel>

        <controls:SplitView x:Name="LoreSplitView"
                            Grid.Row="1"
                            Background="Transparent"
                            DisplayMode="Inline"
                            IsPaneOpen="True"
                            OpenPaneLength="336"
                            PaneBackground="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                            CompactPaneLength="0">
            <controls:SplitView.Pane>
                <Grid Margin="0,0,16,0"
                      Background="Transparent">
                    <Border Style="{StaticResource SectionCardStyle}"
                            Margin="0"
                            Padding="16">
                        <Grid RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0"
                                        Spacing="6">
                                <TextBlock Text="Library"
                                           FontSize="18"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="Search included titles and document content, then browse the library."
                                           Style="{StaticResource SectionBodyTextStyle}" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="SearchTextBox"
                                             AutomationProperties.AutomationId="LoreSearchBox"
                                             AutomationProperties.Name="Search lore documents"
                                             PlaceholderText="Search documents"
                                             TextChanged="SearchTextBox_TextChanged" />
                                    <Button Grid.Column="1"
                                            AutomationProperties.AutomationId="LoreRefreshButton"
                                            Content="Refresh"
                                            Click="RefreshButton_Click" />
                                </Grid>
                            </StackPanel>

                            <TextBlock x:Name="PaneStateTextBlock"
                                       AutomationProperties.AutomationId="LoreLibraryStatus"
                                       Grid.Row="1"
                                       Style="{StaticResource SectionBodyTextStyle}"
                                       Text="Library unavailable." />

                            <TreeView x:Name="DocumentTree"
                                      AutomationProperties.AutomationId="LoreDocumentTree"
                                      AutomationProperties.Name="Lore document library"
                                      Grid.Row="2"
                                      Background="Transparent"
                                      SelectionMode="Single"
                                      ItemInvoked="DocumentTree_ItemInvoked"
                                      SelectionChanged="DocumentTree_SelectionChanged" />

                            <Expander x:Name="LoreSearchHitsExpander"
                                      AutomationProperties.AutomationId="LoreSearchHitsExpander"
                                      AutomationProperties.Name="Full-text search matches with snippets"
                                      Header="Search matches in document text"
                                      Grid.Row="3"
                                      Margin="0,4,0,0"
                                      IsExpanded="False">
                                <StackPanel Spacing="8">
                                    <TextBlock x:Name="LoreSearchHitsStatus"
                                               AutomationProperties.AutomationId="LoreSearchHitsStatus"
                                               AutomationProperties.LiveSetting="Polite"
                                               Style="{StaticResource SectionBodyTextStyle}"
                                               Text="Type a word to find every document containing it, with the matching sentence." />
                                    <ItemsControl x:Name="LoreSearchHitsList"
                                                  AutomationProperties.AutomationId="LoreSearchHitsList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="helpers:LoreSearchHitModel">
                                                <Button AutomationProperties.AutomationId="LoreSearchHitButton"
                                                        AutomationProperties.Name="{Binding AccessibilityName}"
                                                        HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Stretch"
                                                        Margin="0,0,0,6"
                                                        Padding="10,8"
                                                        Click="LoreSearchHitButton_Click">
                                                    <StackPanel Spacing="2">
                                                        <TextBlock Text="{Binding DocumentTitle}"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="13"
                                                                   TextWrapping="WrapWholeWords" />
                                                        <TextBlock x:Name="LoreSearchHitSectionHeading"
                                                                   x:Load="{x:Bind HasSectionTarget}"
                                                                   FontSize="11"
                                                                   Foreground="{ThemeResource ShellMutedTextBrush}"
                                                                   TextWrapping="WrapWholeWords"
                                                                   Text="{x:Bind SectionLine}" />
                                                        <TextBlock FontSize="12"
                                                                   Foreground="{ThemeResource ShellMutedTextBrush}"
                                                                   TextWrapping="WrapWholeWords">
                                                            <Run Text="{Binding SnippetBefore, Mode=OneWay}" />
                                                            <Run Text="{Binding MatchedText, Mode=OneWay}"
                                                                 FontWeight="SemiBold" />
                                                            <Run Text="{Binding SnippetAfter, Mode=OneWay}" />
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Expander>
                        </Grid>
                    </Border>
                </Grid>
            </controls:SplitView.Pane>
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Style="{StaticResource SectionCardStyle}"
                        Margin="0,0,0,12"
                        Padding="6,0">
                        <CommandBar Background="Transparent"
                                    DefaultLabelPosition="Right"
                                    HorizontalAlignment="Left"
                                    IsDynamicOverflowEnabled="False">
                        <CommandBar.PrimaryCommands>
                            <AppBarButton x:Name="BackButton"
                                          AutomationProperties.AutomationId="LoreBackButton"
                                          Label="Back"
                                          Click="BackButton_Click">
                                <AppBarButton.Icon>
                                    <SymbolIcon Symbol="Back" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarButton x:Name="ForwardButton"
                                          AutomationProperties.AutomationId="LoreForwardButton"
                                          Label="Forward"
                                          Click="ForwardButton_Click">
                                <AppBarButton.Icon>
                                    <SymbolIcon Symbol="Forward" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarButton x:Name="HomeButton"
                                          AutomationProperties.AutomationId="LoreHomeButton"
                                          Label="Home"
                                          Click="HomeButton_Click">
                                <AppBarButton.Icon>
                                    <SymbolIcon Symbol="Home" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarButton x:Name="ToggleLibraryButton"
                                          AutomationProperties.AutomationId="LoreToggleLibraryButton"
                                          Label="Hide Library"
                                          Click="ToggleLibraryButton_Click">
                                <AppBarButton.Icon>
                                    <SymbolIcon Symbol="List" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarSeparator />
                            <AppBarButton x:Name="OpenExternalButton"
                                          AutomationProperties.AutomationId="LoreOpenExternalButton"
                                          Label="Open in browser"
                                          Click="OpenExternalButton_Click">
                                <AppBarButton.Icon>
                                    <SymbolIcon Symbol="OpenFile" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                        </CommandBar.PrimaryCommands>
                    </CommandBar>
                </Border>

                <Border Grid.Row="1"
                        Style="{StaticResource SectionCardStyle}"
                        Margin="0,0,0,12"
                        Padding="16">
                    <StackPanel Spacing="4">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock x:Name="CurrentDocumentTextBlock"
                                           AutomationProperties.AutomationId="LoreCurrentDocumentTitle"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           Text="Select a document" />
                                <TextBlock x:Name="CurrentPathTextBlock"
                                           AutomationProperties.AutomationId="LoreCurrentDocumentSummary"
                                           Style="{StaticResource SectionBodyTextStyle}"
                                           Text="Included Lore opens here; Source and External links may open your browser." />
                            </StackPanel>
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        VerticalAlignment="Top">
                                <TextBlock Text="Text size"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource ShellMutedTextBrush}" />
                                <Button x:Name="ReaderTextSmallerButton"
                                        AutomationProperties.AutomationId="LoreTextSmallerButton"
                                        AutomationProperties.Name="A-: make lore text smaller"
                                        Content="A-"
                                        MinWidth="44"
                                        Click="ReaderTextSizeButton_Click" />
                                <Button x:Name="ReaderTextLargerButton"
                                        AutomationProperties.AutomationId="LoreTextLargerButton"
                                        AutomationProperties.Name="A+: make lore text larger"
                                        Content="A+"
                                        MinWidth="44"
                                        Click="ReaderTextSizeButton_Click" />
                            </StackPanel>
                        </Grid>
                        <Expander x:Name="LoreBacklinksExpander"
                                  AutomationProperties.AutomationId="LoreBacklinksExpander"
                                  AutomationProperties.Name="Documents that link to this one"
                                  Header="What links here"
                                  Margin="0,6,0,0"
                                  IsExpanded="False">
                            <StackPanel Spacing="4">
                                <TextBlock x:Name="LoreBacklinksStatus"
                                           AutomationProperties.AutomationId="LoreBacklinksStatus"
                                           Style="{StaticResource SectionBodyTextStyle}"
                                           TextWrapping="WrapWholeWords"
                                           Text="Loading cross-links..." />
                                <ItemsControl x:Name="LoreBacklinksList"
                                              AutomationProperties.AutomationId="LoreBacklinksList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="helpers:LoreBacklinkModel">
                                            <HyperlinkButton AutomationProperties.AutomationId="LoreBacklinkButton"
                                                             AutomationProperties.Name="{Binding AccessibilityName}"
                                                             Content="{Binding SourceDocumentTitle}"
                                                             Click="LoreBacklinkButton_Click" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Expander>
                        <Expander x:Name="LoreOutlineExpander"
                                  AutomationProperties.AutomationId="LoreOutlineExpander"
                                  AutomationProperties.Name="Headings on this page"
                                  Header="On this page"
                                  Margin="0,6,0,0"
                                  IsExpanded="False">
                            <StackPanel Spacing="4">
                                <TextBlock x:Name="LoreOutlineStatus"
                                           AutomationProperties.AutomationId="LoreOutlineStatus"
                                           Style="{StaticResource SectionBodyTextStyle}"
                                           TextWrapping="WrapWholeWords"
                                           Text="Loading outline..." />
                                <ItemsControl x:Name="LoreOutlineList"
                                              AutomationProperties.AutomationId="LoreOutlineList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="helpers:LoreOutlineEntryModel">
                                            <HyperlinkButton AutomationProperties.AutomationId="LoreOutlineButton"
                                                             AutomationProperties.Name="{Binding AccessibilityName}"
                                                             Content="{Binding Text}"
                                                             Margin="{Binding RowMargin}"
                                                             Click="LoreOutlineButton_Click" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Expander>
                        <Expander x:Name="LoreOutgoingExpander"
                                  AutomationProperties.AutomationId="LoreOutgoingExpander"
                                  AutomationProperties.Name="Documents this page links to"
                                  Header="This page links to"
                                  Margin="0,6,0,0"
                                  IsExpanded="False">
                            <StackPanel Spacing="4">
                                <TextBlock x:Name="LoreOutgoingStatus"
                                           AutomationProperties.AutomationId="LoreOutgoingStatus"
                                           Style="{StaticResource SectionBodyTextStyle}"
                                           TextWrapping="WrapWholeWords"
                                           Text="Loading outgoing links..." />
                                <ItemsControl x:Name="LoreOutgoingList"
                                              AutomationProperties.AutomationId="LoreOutgoingList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="helpers:LoreOutgoingLinkModel">
                                            <HyperlinkButton AutomationProperties.AutomationId="LoreOutgoingButton"
                                                             AutomationProperties.Name="{Binding AccessibilityName}"
                                                             Content="{Binding TargetDocumentTitle}"
                                                             Click="LoreOutgoingButton_Click" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2"
                        AutomationProperties.AutomationId="LoreReaderPanel"
                        AutomationProperties.Name="Lore document reader"
                        Background="{ThemeResource ShellSurfaceBrush}"
                        BorderBrush="{ThemeResource ShellBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="16">
                    <Grid>
                        <ScrollViewer x:Name="ReaderScrollViewer"
                                      AutomationProperties.AutomationId="LoreReaderScrollViewer"
                                      AutomationProperties.Name="Lore document scroll area"
                                      HorizontalScrollBarVisibility="Disabled"
                                      HorizontalScrollMode="Disabled"
                                      VerticalScrollBarVisibility="Auto"
                                      Padding="28,24,28,28">
                            <ContentControl x:Name="ContentReader"
                                            AutomationProperties.AutomationId="LoreContentReader"
                                            AutomationProperties.Name="Rendered lore document"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            IsTabStop="False" />
                        </ScrollViewer>

                        <Border x:Name="ReaderPlaceholderBorder"
                                AutomationProperties.AutomationId="LoreReaderPlaceholder"
                                Background="{ThemeResource ShellSurfaceBrush}"
                                CornerRadius="16">
                            <StackPanel Width="420"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="8">
                                <TextBlock x:Name="ReaderPlaceholderTitleTextBlock"
                                           AutomationProperties.AutomationId="LoreReaderPlaceholderTitle"
                                           FontSize="24"
                                           FontWeight="SemiBold"
                                           Text="Loading lore library..." />
                                <TextBlock x:Name="ReaderPlaceholderBodyTextBlock"
                                           AutomationProperties.AutomationId="LoreReaderPlaceholderBody"
                                           Style="{StaticResource SectionBodyTextStyle}"
                                           Text="The embedded reader will appear here once the library is ready." />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </controls:SplitView>
    </Grid>
</Page>
