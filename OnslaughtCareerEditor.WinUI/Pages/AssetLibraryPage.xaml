<Page
    x:Class="OnslaughtCareerEditor.WinUI.Pages.AssetLibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid Padding="20,18,20,24"
          RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Spacing="6">
            <TextBlock Text="Asset Library"
                       AutomationProperties.AutomationId="AssetLibraryPageTitle"
                       AutomationProperties.HeadingLevel="Level1"
                       Style="{StaticResource SectionTitleTextStyle}" />
            <TextBlock Text="Browse the game's textures and models - once you have exported them. This page is a viewer, and the export tool is not part of the app yet, so most people will find nothing to open here. Media and Lore work straight away and need no setup."
                       AutomationProperties.AutomationId="AssetLibraryPagePurpose"
                       Style="{StaticResource SectionBodyTextStyle}" />
        </StackPanel>

        <Border x:Name="CatalogLoadCardBorder"
                Grid.Row="1"
                Style="{StaticResource SectionCardStyle}">
            <Grid RowSpacing="10"
                  ColumnSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="Load generated catalog"
                               FontSize="18"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="CatalogStatusTextBlock"
                               AutomationProperties.AutomationId="AssetCatalogStatus"
                               Style="{StaticResource SectionBodyTextStyle}"
                               Text="Paste catalog.json, or browse to a generated export folder." />
                    <Border x:Name="CatalogFirstRunGuideBorder"
                            Background="{ThemeResource ShellMutedSurfaceBrush}"
                            BorderBrush="{ThemeResource ShellBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12">
                        <StackPanel AutomationProperties.AutomationId="AssetCatalogFirstRunGuide"
                                    AutomationProperties.Name="Catalog viewer. Asset Library opens an existing export catalog. Point it at the folder containing asset_catalog/catalog.json."
                                    Spacing="4">
                            <TextBlock Text="Catalog viewer"
                                       FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource SectionBodyTextStyle}"
                                       Text="Asset Library opens an existing export catalog. It does not create one, and the app does not ship one." />
                            <TextBlock Style="{StaticResource SectionBodyTextStyle}"
                                       Text="If you have exported assets before, choose the folder containing asset_catalog/catalog.json - not your game folder." />
                            <TextBlock Style="{StaticResource SectionBodyTextStyle}"
                                       Text="If you have not, there is nothing to open here yet. Exporting textures and models still needs tools that are not part of the app." />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8">
                    <Button x:Name="ChangeCatalogButton"
                            AutomationProperties.AutomationId="AssetChangeCatalogButton"
                            Content="Change catalog"
                            HorizontalAlignment="Left"
                            Visibility="Collapsed"
                            Click="ChangeCatalogButton_Click" />
                    <Button x:Name="ExportModdingManifestButton"
                            AutomationProperties.AutomationId="AssetExportModdingManifestButton"
                            AutomationProperties.Name="Export modding manifest: names, ids, and hashes only, no game assets"
                            Content="Export modding manifest"
                            Visibility="Collapsed"
                            Click="ExportModdingManifestButton_Click" />
                    <Button x:Name="ExportModdingCatalogTsvButton"
                            AutomationProperties.AutomationId="AssetExportModdingCatalogTsvButton"
                            AutomationProperties.Name="Export catalog TSV: names, ids, and hashes only, no game assets"
                            Content="Export catalog TSV"
                            Visibility="Collapsed"
                            Click="ExportModdingCatalogTsvButton_Click" />
                    <Expander x:Name="CatalogPathDetailsExpander"
                              Header="File details"
                              IsExpanded="False">
                        <TextBlock x:Name="CatalogFullPathTextBlock"
                                   AutomationProperties.AutomationId="AssetCatalogFile"
                                   FontFamily="Consolas"
                                   FontSize="12"
                                   MaxWidth="420"
                                   TextWrapping="WrapWholeWords" />
                    </Expander>
                </StackPanel>
                <Grid x:Name="CatalogInputGrid"
                      Grid.Row="1"
                      Grid.ColumnSpan="2"
                      ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="CatalogPathTextBox"
                             Grid.Column="0"
                             AutomationProperties.AutomationId="AssetCatalogFileTextBox"
                             PlaceholderText="Paste catalog.json, or browse to a generated export folder" />
                    <Button x:Name="BrowseCatalogButton"
                            Grid.Column="1"
                            AutomationProperties.AutomationId="AssetBrowseCatalogButton"
                            AutomationProperties.Name="Browse export folder for a generated catalog"
                            Content="Browse export folder"
                            Click="BrowseCatalogButton_Click" />
                    <Button Grid.Column="2"
                            x:Name="LoadCatalogButton"
                            AutomationProperties.AutomationId="AssetLoadCatalogButton"
                            Content="Load catalog"
                            Style="{StaticResource PrimaryActionButtonStyle}"
                            Click="LoadCatalogButton_Click" />
                </Grid>
                <StackPanel x:Name="GoodieSaveStatePanel"
                            Grid.Row="2"
                            Grid.ColumnSpan="2"
                            Visibility="Collapsed"
                            Spacing="8">
                    <StackPanel Spacing="3">
                        <TextBlock Text="Save state for Goodies"
                                   FontSize="16"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="GoodieSaveStateStatusTextBlock"
                                   AutomationProperties.AutomationId="AssetGoodieSaveStateStatus"
                                   AutomationProperties.LiveSetting="Polite"
                                   Style="{StaticResource SectionBodyTextStyle}"
                                   Text="Optional: load a copied .bes save to show locked, newly unlocked, and viewed Goodies states." />
                    </StackPanel>
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="GoodieSaveStatePathTextBox"
                                 Grid.Column="0"
                                 AutomationProperties.AutomationId="AssetGoodieSaveStateFileTextBox"
                                 PlaceholderText="Choose a copied .bes save for Goodies state" />
                        <Button Grid.Column="1"
                                AutomationProperties.AutomationId="AssetBrowseGoodieSaveStateButton"
                                Content="Browse"
                                Click="BrowseGoodieSaveStateButton_Click" />
                        <Button Grid.Column="2"
                                AutomationProperties.AutomationId="AssetLoadGoodieSaveStateButton"
                                Content="Load state"
                                Click="LoadGoodieSaveStateButton_Click" />
                        <Button Grid.Column="3"
                                AutomationProperties.AutomationId="AssetClearGoodieSaveStateButton"
                                Content="Clear"
                                Click="ClearGoodieSaveStateButton_Click" />
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="ModProjectPlannerCardBorder"
                Grid.Row="2"
                Style="{StaticResource SectionCardStyle}"
                Visibility="Collapsed">
            <Grid RowSpacing="10"
                  ColumnSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.95*" />
                    <ColumnDefinition Width="1.35*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.ColumnSpan="2"
                            Spacing="3">
                    <TextBlock Text="Mod project manifest planner"
                               FontSize="18"
                               FontWeight="SemiBold" />
                    <TextBlock AutomationProperties.AutomationId="AssetModProjectBoundary"
                               Style="{StaticResource SectionBodyTextStyle}"
                               Text="Select up to 100 catalog rows for a metadata-only plan receipt. It is not an asset pack, not an installer, and not a compatibility guarantee; it copies no game assets."
                               TextWrapping="WrapWholeWords" />
                </StackPanel>

                <StackPanel Grid.Row="1"
                            Spacing="5">
                    <TextBlock x:Name="ModProjectSummaryTextBlock"
                               AutomationProperties.AutomationId="AssetModProjectSummary"
                               Style="{StaticResource SectionBodyTextStyle}"
                               Text="No catalog rows are selected for this project plan." />
                    <TextBlock x:Name="ModProjectProvenanceTextBlock"
                               AutomationProperties.AutomationId="AssetModProjectProvenance"
                               FontFamily="Consolas"
                               FontSize="12"
                               Text="Catalog provenance appears after rows are selected."
                               TextWrapping="WrapWholeWords" />
                    <StackPanel Orientation="Horizontal"
                                Spacing="8">
                        <Button x:Name="AddCurrentToModProjectButton"
                                AutomationProperties.AutomationId="AssetAddCurrentToModProjectButton"
                                AutomationProperties.Name="Add current row to mod project plan receipt"
                                Content="Add current row"
                                IsEnabled="False"
                                Click="AddCurrentToModProjectButton_Click" />
                        <Button x:Name="RemoveModProjectRowButton"
                                AutomationProperties.AutomationId="AssetRemoveModProjectRowButton"
                                Content="Remove plan row"
                                IsEnabled="False"
                                Click="RemoveModProjectRowButton_Click" />
                        <Button x:Name="ClearModProjectButton"
                                AutomationProperties.AutomationId="AssetClearModProjectButton"
                                Content="Clear plan"
                                IsEnabled="False"
                                Click="ClearModProjectButton_Click" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1"
                            Grid.Column="1"
                            Spacing="7">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ModProjectOutputPathTextBox"
                                 AutomationProperties.AutomationId="AssetModProjectOutputFileTextBox"
                                 PlaceholderText="Choose a .json project plan receipt file"
                                 TextChanged="ModProjectOutputPathTextBox_TextChanged" />
                        <Button Grid.Column="1"
                                AutomationProperties.AutomationId="AssetBrowseModProjectOutputButton"
                                Content="Browse"
                                Click="BrowseModProjectOutputButton_Click" />
                    </Grid>
                    <StackPanel Orientation="Horizontal"
                                Spacing="10">
                        <CheckBox x:Name="ModProjectIncludeTsvCheckBox"
                                  AutomationProperties.AutomationId="AssetModProjectIncludeTsvCheckBox"
                                  Content="Optional TSV beside the JSON receipt"
                                  IsChecked="True" />
                        <Button x:Name="ExportModProjectPlanButton"
                                AutomationProperties.AutomationId="AssetExportModProjectPlanButton"
                                AutomationProperties.Name="Export project plan as a metadata-only receipt with no game assets"
                                Content="Export project plan"
                                IsEnabled="False"
                                Style="{StaticResource PrimaryActionButtonStyle}"
                                Click="ExportModProjectPlanButton_Click" />
                    </StackPanel>
                    <TextBlock x:Name="ModProjectStatusTextBlock"
                               AutomationProperties.AutomationId="AssetModProjectStatus"
                               Style="{StaticResource SectionBodyTextStyle}"
                               Text="Add rows from the loaded catalog, then choose where to write the plan receipt."
                               TextWrapping="WrapWholeWords" />
                </StackPanel>

                <ListView x:Name="ModProjectItemsListView"
                          Grid.Row="2"
                          Grid.ColumnSpan="2"
                          AutomationProperties.AutomationId="AssetModProjectItemsList"
                          AutomationProperties.Name="Selected mod project plan rows"
                          MaxHeight="180"
                          SelectionChanged="ModProjectItemsListView_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Padding="4,6"
                                        Spacing="1">
                                <TextBlock Text="{Binding DisplayName}"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Identity}"
                                           FontFamily="Consolas"
                                           FontSize="12" />
                                <TextBlock Text="{Binding ExportSummary}"
                                           FontSize="12"
                                           Foreground="{ThemeResource ShellMutedTextBrush}" />
                                <TextBlock Text="{Binding HashSummary}"
                                           FontFamily="Consolas"
                                           FontSize="11"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <Border x:Name="ManifestReviewCardBorder"
                Grid.Row="3"
                Style="{StaticResource SectionCardStyle}"
                Visibility="Collapsed">
            <Expander x:Name="ManifestReviewExpander"
                      AutomationProperties.AutomationId="AssetManifestReviewExpander"
                      Header="Manifest revalidation / drift review"
                      IsExpanded="False">
                <Grid Margin="0,10,0,0"
                      RowSpacing="10"
                      ColumnSpacing="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.05*" />
                        <ColumnDefinition Width="1.25*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.ColumnSpan="2"
                               AutomationProperties.AutomationId="AssetManifestReviewBoundary"
                               Style="{StaticResource SectionBodyTextStyle}"
                               Text="Open an existing versioned planner JSON manifest and compare it with the loaded generated catalog. The metadata-only review receipt copies no game, catalog, or asset bytes."
                               TextWrapping="WrapWholeWords" />

                    <StackPanel Grid.Row="1"
                                Spacing="6">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ManifestReviewInputPathTextBox"
                                     AutomationProperties.AutomationId="AssetManifestReviewInputFileTextBox"
                                     PlaceholderText="Choose an existing mod project plan JSON manifest"
                                     TextChanged="ManifestReviewInputPathTextBox_TextChanged" />
                            <Button Grid.Column="1"
                                    AutomationProperties.AutomationId="AssetBrowseManifestReviewInputButton"
                                    Content="Browse"
                                    Click="BrowseManifestReviewInputButton_Click" />
                            <Button x:Name="ReviewManifestButton"
                                    Grid.Column="2"
                                    AutomationProperties.AutomationId="AssetReviewManifestButton"
                                    AutomationProperties.Name="Review manifest: run metadata-only manifest drift review"
                                    Content="Review manifest"
                                    IsEnabled="False"
                                    Click="ReviewManifestButton_Click" />
                        </Grid>
                        <TextBlock x:Name="ManifestReviewSummaryTextBlock"
                                   AutomationProperties.AutomationId="AssetManifestReviewSummary"
                                   Style="{StaticResource SectionBodyTextStyle}"
                                   Text="No planner manifest has been reviewed against the loaded catalog."
                                   TextWrapping="WrapWholeWords" />
                        <TextBlock x:Name="ManifestReviewProvenanceTextBlock"
                                   AutomationProperties.AutomationId="AssetManifestReviewProvenance"
                                   FontFamily="Consolas"
                                   FontSize="11"
                                   Text="Original manifest and current catalog provenance appear after review."
                                   TextWrapping="WrapWholeWords" />
                    </StackPanel>

                    <StackPanel Grid.Row="1"
                                Grid.Column="1"
                                Spacing="7">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ManifestReviewOutputPathTextBox"
                                     AutomationProperties.AutomationId="AssetManifestReviewOutputFileTextBox"
                                     PlaceholderText="Choose a new .json review receipt file"
                                     TextChanged="ManifestReviewOutputPathTextBox_TextChanged" />
                            <Button Grid.Column="1"
                                    AutomationProperties.AutomationId="AssetBrowseManifestReviewOutputButton"
                                    Content="Browse"
                                    Click="BrowseManifestReviewOutputButton_Click" />
                        </Grid>
                        <StackPanel Orientation="Horizontal"
                                    Spacing="10">
                            <CheckBox x:Name="ManifestReviewIncludeTsvCheckBox"
                                      AutomationProperties.AutomationId="AssetManifestReviewIncludeTsvCheckBox"
                                      Content="Optional TSV beside the JSON receipt"
                                      IsChecked="True" />
                            <Button x:Name="ExportManifestReviewReceiptButton"
                                    AutomationProperties.AutomationId="AssetExportManifestReviewReceiptButton"
                                    AutomationProperties.Name="Export review receipt: exact metadata-only manifest review receipt"
                                    Content="Export review receipt"
                                    IsEnabled="False"
                                    Style="{StaticResource PrimaryActionButtonStyle}"
                                    Click="ExportManifestReviewReceiptButton_Click" />
                        </StackPanel>
                        <TextBlock x:Name="ManifestReviewStatusTextBlock"
                                   AutomationProperties.AutomationId="AssetManifestReviewStatus"
                                   Style="{StaticResource SectionBodyTextStyle}"
                                   Text="Choose an existing mod project plan JSON manifest, then run the metadata-only drift review."
                                   TextWrapping="WrapWholeWords" />
                    </StackPanel>

                    <ListView x:Name="ManifestReviewItemsListView"
                              Grid.Row="2"
                              Grid.ColumnSpan="2"
                              AutomationProperties.AutomationId="AssetManifestReviewItemsList"
                              AutomationProperties.Name="Bounded manifest drift review details"
                              MaxHeight="150">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Padding="4,5"
                                            Spacing="1">
                                    <TextBlock Text="{Binding DisplayName}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Identity}"
                                               FontFamily="Consolas"
                                               FontSize="11" />
                                    <TextBlock Text="{Binding StatusLabel}"
                                               FontWeight="SemiBold"
                                               FontSize="12" />
                                    <TextBlock Text="{Binding Detail}"
                                               FontSize="12"
                                               TextWrapping="WrapWholeWords" />
                                    <TextBlock Text="{Binding HashSummary}"
                                               FontFamily="Consolas"
                                               FontSize="10"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Expander>
        </Border>

        <Grid Grid.Row="4"
              ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*" />
                <ColumnDefinition Width="1.25*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource SectionCardStyle}">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0"
                                Spacing="4">
                        <TextBlock Text="Catalog browser"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="CatalogSummaryTextBlock"
                                   AutomationProperties.AutomationId="AssetCatalogSummary"
                                   Style="{StaticResource SectionBodyTextStyle}"
                                   Text="Load a catalog to see textures, meshes, and goodies." />
                        <TextBlock x:Name="CatalogCoverageTextBlock"
                                   AutomationProperties.AutomationId="AssetCatalogCoverageSummary"
                                   Style="{StaticResource SectionBodyTextStyle}"
                                   Text="Coverage summary appears after a generated catalog loads."
                                   MaxLines="3"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="WrapWholeWords" />
                        <TextBlock x:Name="CatalogProvenanceTextBlock"
                                   AutomationProperties.AutomationId="AssetCatalogProvenanceSummary"
                                   Style="{StaticResource SectionBodyTextStyle}"
                                   Text="Catalog provenance appears after a generated catalog loads."
                                   MaxLines="3"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="WrapWholeWords" />
                    </StackPanel>

                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                Spacing="8">
                        <Button x:Name="TexturesTabButton"
                                AutomationProperties.AutomationId="AssetTexturesTabButton"
                                Content="Textures"
                                Style="{StaticResource SubTabActiveButtonStyle}"
                                Click="TexturesTabButton_Click" />
                        <Button x:Name="MeshesTabButton"
                                AutomationProperties.AutomationId="AssetMeshesTabButton"
                                Content="Meshes"
                                Style="{StaticResource SubTabInactiveButtonStyle}"
                                Click="MeshesTabButton_Click" />
                        <Button x:Name="EmbeddedMeshesTabButton"
                                AutomationProperties.AutomationId="AssetEmbeddedMeshesTabButton"
                                Content="Embedded"
                                Style="{StaticResource SubTabInactiveButtonStyle}"
                                Click="EmbeddedMeshesTabButton_Click" />
                        <Button x:Name="GoodiesTabButton"
                                AutomationProperties.AutomationId="AssetGoodiesTabButton"
                                Content="Goodies"
                                Style="{StaticResource SubTabInactiveButtonStyle}"
                                Click="GoodiesTabButton_Click" />
                    </StackPanel>

                    <Grid Grid.Row="2"
                          RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Spacing="6">
                        <TextBox x:Name="AssetSearchBox"
                                 AutomationProperties.AutomationId="AssetSearchBox"
                                 PlaceholderText="Search current asset list"
                                 TextChanged="AssetSearchBox_TextChanged" />
                        <TextBlock x:Name="AssetListNoteTextBlock"
                                   AutomationProperties.AutomationId="AssetListNote"
                                   Style="{StaticResource SectionBodyTextStyle}"
                                   TextWrapping="WrapWholeWords"
                                   Visibility="Collapsed" />
                        </StackPanel>
                        <StackPanel x:Name="GoodieFilterPanel"
                                    Grid.Row="1"
                                    Spacing="6"
                                    Visibility="Collapsed">
                            <Grid ColumnSpacing="8"
                                  RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Button x:Name="GoodiesAllFilterButton"
                                        AutomationProperties.AutomationId="AssetGoodiesAllFilterButton"
                                        Content="All"
                                        Style="{StaticResource SubTabActiveButtonStyle}"
                                        Click="GoodiesAllFilterButton_Click" />
                                <Button x:Name="GoodiesWallFilterButton"
                                        Grid.Column="1"
                                        AutomationProperties.AutomationId="AssetGoodiesWallFilterButton"
                                        Content="Wall"
                                        Style="{StaticResource SubTabInactiveButtonStyle}"
                                        Click="GoodiesWallFilterButton_Click" />
                                <Button x:Name="GoodiesHiddenFilterButton"
                                        Grid.Column="2"
                                        AutomationProperties.AutomationId="AssetGoodiesHiddenFilterButton"
                                        Content="Hidden"
                                        Style="{StaticResource SubTabInactiveButtonStyle}"
                                        Click="GoodiesHiddenFilterButton_Click" />
                                <Button x:Name="GoodiesModelsFilterButton"
                                        Grid.Row="1"
                                        AutomationProperties.AutomationId="AssetGoodiesModelsFilterButton"
                                        Content="Models"
                                        Style="{StaticResource SubTabInactiveButtonStyle}"
                                        Click="GoodiesModelsFilterButton_Click" />
                                <Button x:Name="GoodiesArtworkFilterButton"
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        AutomationProperties.AutomationId="AssetGoodiesArtworkFilterButton"
                                        Content="Artwork"
                                        Style="{StaticResource SubTabInactiveButtonStyle}"
                                        Click="GoodiesArtworkFilterButton_Click" />
                                <Button x:Name="GoodiesVideosFilterButton"
                                        Grid.Row="1"
                                        Grid.Column="2"
                                        AutomationProperties.AutomationId="AssetGoodiesVideosFilterButton"
                                        Content="Videos"
                                        Style="{StaticResource SubTabInactiveButtonStyle}"
                                        Click="GoodiesVideosFilterButton_Click" />
                            </Grid>
                            <TextBlock x:Name="GoodiesFilterStatusTextBlock"
                                       AutomationProperties.AutomationId="AssetGoodiesFilterStatus"
                                       Style="{StaticResource SectionBodyTextStyle}"
                                       Text="Goodies filters use catalog links; in-game wall availability is not shown here."
                                       TextWrapping="WrapWholeWords" />
                        </StackPanel>
                        <ListView x:Name="AssetItemsListView"
                                  Grid.Row="2"
                                  AutomationProperties.AutomationId="AssetItemsList"
                                  AutomationProperties.Name="Asset list"
                                  SelectionChanged="AssetItemsListView_SelectionChanged">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Padding="4,8"
                                                Spacing="2">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding ExportFileName}"
                                                   FontSize="12"
                                                   Foreground="{ThemeResource ShellMutedTextBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Style="{StaticResource SectionCardStyle}">
                <ScrollViewer AutomationProperties.AutomationId="AssetPreviewScrollViewer"
                              AutomationProperties.Name="Asset preview details">
                    <StackPanel Spacing="12">
                        <TextBlock x:Name="SelectedAssetTitleTextBlock"
                                   AutomationProperties.AutomationId="AssetSelectedTitle"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Text="Choose an asset" />
                        <TextBlock x:Name="SelectedAssetSummaryTextBlock"
                                   AutomationProperties.AutomationId="AssetSelectedSummary"
                                   Style="{StaticResource SectionBodyTextStyle}"
                                   Text="Pick a texture or mesh to review local export status." />
                        <TextBlock x:Name="ModelMetadataInlineTextBlock"
                                   AutomationProperties.AutomationId="AssetModelMetadataInline"
                                   Style="{StaticResource SectionBodyTextStyle}"
                                   FontWeight="SemiBold"
                                   Visibility="Collapsed"
                                   Text="Model facts appear here when a local FBX export is selected." />
                        <TextBlock x:Name="PreviewTitleTextBlock"
                                   AutomationProperties.AutomationId="AssetPreviewTitle"
                                   Text="Texture preview"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                        <StackPanel x:Name="ModelViewControlsPanel"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    Visibility="Collapsed">
                            <TextBlock Text="Model view"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource SectionBodyTextStyle}" />
                            <Button x:Name="ModelViewFrontButton"
                                    AutomationProperties.AutomationId="AssetModelViewFrontButton"
                                    Content="Front"
                                    Click="ModelViewFrontButton_Click" />
                            <Button x:Name="ModelViewSideButton"
                                    AutomationProperties.AutomationId="AssetModelViewSideButton"
                                    Content="Side"
                                    Click="ModelViewSideButton_Click" />
                            <Button x:Name="ModelViewTopButton"
                                    AutomationProperties.AutomationId="AssetModelViewTopButton"
                                    Content="Top"
                                    Click="ModelViewTopButton_Click" />
                            <Button x:Name="ModelViewIsoButton"
                                    AutomationProperties.AutomationId="AssetModelViewIsoButton"
                                    Content="Iso"
                                    Click="ModelViewIsoButton_Click" />
                        </StackPanel>
                        <TextBlock x:Name="ModelWireframeStatusTextBlock"
                                   AutomationProperties.AutomationId="AssetModelWireframeStatus"
                                   Style="{StaticResource SectionBodyTextStyle}"
                                   Visibility="Collapsed"
                                   Text="Wireframe preview status appears here for assistive technology." />
                        <Border x:Name="ModelWireframePreviewPanel"
                                Background="{ThemeResource ShellStatusBrush}"
                                BorderBrush="{ThemeResource ShellBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="10"
                                MinHeight="128"
                                Visibility="Collapsed">
                            <Grid>
                                <TextBlock AutomationProperties.AutomationId="AssetModelWireframePanel"
                                           AutomationProperties.Name="Model wireframe preview"
                                           HorizontalAlignment="Stretch"
                                           VerticalAlignment="Stretch"
                                           IsHitTestVisible="False" />
                                <Canvas x:Name="ModelWireframeCanvas"
                                        AutomationProperties.AutomationId="AssetModelWireframeCanvas"
                                        Width="360"
                                        Height="190" />
                                <TextBlock x:Name="ModelWireframeEmptyTextBlock"
                                           AutomationProperties.AutomationId="AssetModelWireframeEmpty"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource SectionBodyTextStyle}"
                                           Text="Wireframe preview appears when vertex and polygon index data are readable." />
                            </Grid>
                        </Border>
                        <TextBlock x:Name="ModelWireframeNoteTextBlock"
                                   Text="Wireframe is a lightweight geometry check, not final material or animation rendering."
                                   Style="{StaticResource SectionBodyTextStyle}"
                                   Visibility="Collapsed" />
                        <Border x:Name="TexturePreviewPanel"
                                Background="{ThemeResource TexturePreviewNeutralBrush}"
                                BorderBrush="{ThemeResource ShellBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="12"
                                Height="240">
                            <Grid>
                                <Image x:Name="TexturePreviewImage"
                                       AutomationProperties.AutomationId="AssetTexturePreviewImage"
                                       Stretch="Uniform" />
                                <TextBlock x:Name="TexturePreviewEmptyTextBlock"
                                           AutomationProperties.AutomationId="AssetTexturePreviewEmpty"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Text="Texture preview appears here when the selected export is available."
                                           Style="{StaticResource SectionBodyTextStyle}" />
                            </Grid>
                        </Border>
                        <StackPanel x:Name="GoodieFactsPanel"
                                    AutomationProperties.AutomationId="AssetGoodieFactsPanel"
                                    Spacing="6"
                                    Visibility="Collapsed">
                            <TextBlock Text="Goodie facts"
                                       FontSize="16"
                                       FontWeight="SemiBold" />
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="State"
                                               FontWeight="SemiBold" />
                                    <TextBlock x:Name="GoodieFactStateTextBlock"
                                               AutomationProperties.AutomationId="AssetGoodieFactState"
                                               Style="{StaticResource SectionBodyTextStyle}"
                                               TextWrapping="WrapWholeWords" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Wall"
                                               FontWeight="SemiBold" />
                                    <TextBlock x:Name="GoodieFactWallTextBlock"
                                               AutomationProperties.AutomationId="AssetGoodieFactWall"
                                               Style="{StaticResource SectionBodyTextStyle}"
                                               TextWrapping="WrapWholeWords" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Unlock"
                                               FontWeight="SemiBold" />
                                    <TextBlock x:Name="GoodieFactUnlockTextBlock"
                                               AutomationProperties.AutomationId="AssetGoodieFactUnlock"
                                               Style="{StaticResource SectionBodyTextStyle}"
                                               TextWrapping="WrapWholeWords" />
                                </StackPanel>
                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="Reward"
                                               FontWeight="SemiBold" />
                                    <TextBlock x:Name="GoodieFactRewardTextBlock"
                                               AutomationProperties.AutomationId="AssetGoodieFactReward"
                                               Style="{StaticResource SectionBodyTextStyle}"
                                               TextWrapping="WrapWholeWords" />
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="GoodieFactEvidenceTextBlock"
                                       AutomationProperties.AutomationId="AssetGoodieFactEvidence"
                                       Style="{StaticResource SectionBodyTextStyle}"
                                       TextWrapping="WrapWholeWords" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal"
                                    Spacing="8">
                            <Button x:Name="OpenExportButton"
                                    AutomationProperties.AutomationId="AssetOpenExportButton"
                                    Content="Open export"
                                    IsEnabled="False"
                                    Click="OpenExportButton_Click" />
                            <Button x:Name="OpenInMediaButton"
                                    AutomationProperties.AutomationId="AssetOpenInMediaButton"
                                    Content="Open in Media"
                                    IsEnabled="False"
                                    Visibility="Collapsed"
                                    Click="OpenInMediaButton_Click" />
                            <Button x:Name="CopyExportPathButton"
                                    AutomationProperties.AutomationId="AssetCopyExportFileButton"
                                    Content="Copy file"
                                    IsEnabled="False"
                                    Click="CopyExportPathButton_Click" />
                        </StackPanel>
                        <StackPanel x:Name="TexturePreviewBackgroundPanel"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    Visibility="Collapsed">
                            <TextBlock Text="Preview background"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource SectionBodyTextStyle}" />
                            <Button x:Name="TexturePreviewNeutralButton"
                                    AutomationProperties.AutomationId="TexturePreviewNeutralButton"
                                    Content="Neutral"
                                    Click="TexturePreviewNeutralButton_Click" />
                            <Button x:Name="TexturePreviewLightButton"
                                    AutomationProperties.AutomationId="TexturePreviewLightButton"
                                    Content="Light"
                                    Click="TexturePreviewLightButton_Click" />
                            <Button x:Name="TexturePreviewDarkButton"
                                    AutomationProperties.AutomationId="TexturePreviewDarkButton"
                                    Content="Dark"
                                    Click="TexturePreviewDarkButton_Click" />
                        </StackPanel>
                        <TextBlock x:Name="TexturePreviewCanvasNoteTextBlock"
                                   AutomationProperties.AutomationId="TexturePreviewCanvasNote"
                                   Text="Texture shown on a neutral canvas so dark or transparent game textures are easier to inspect."
                                   Style="{StaticResource SectionBodyTextStyle}"
                                   Visibility="Collapsed" />
                        <Border x:Name="ModelMetadataPanel"
                                AutomationProperties.AutomationId="AssetModelMetadataPanel"
                                Background="{ThemeResource ShellMutedSurfaceBrush}"
                                BorderBrush="{ThemeResource ShellBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="14"
                                Visibility="Collapsed">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Model facts"
                                           FontSize="16"
                                           FontWeight="SemiBold" />
                                <TextBlock x:Name="ModelMetadataStatusTextBlock"
                                           AutomationProperties.AutomationId="AssetModelMetadataStatus"
                                           Style="{StaticResource SectionBodyTextStyle}"
                                           Text="Choose a model export to inspect local FBX metadata." />
                                <Grid ColumnSpacing="10"
                                      RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0"
                                                Grid.Column="0">
                                        <TextBlock Text="Format"
                                                   FontWeight="SemiBold" />
                                        <TextBlock x:Name="ModelFormatTextBlock"
                                                   AutomationProperties.AutomationId="AssetModelFormat"
                                                   Style="{StaticResource SectionBodyTextStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="0"
                                                Grid.Column="1">
                                        <TextBlock Text="File size"
                                                   FontWeight="SemiBold" />
                                        <TextBlock x:Name="ModelSizeTextBlock"
                                                   AutomationProperties.AutomationId="AssetModelSize"
                                                   Style="{StaticResource SectionBodyTextStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1"
                                                Grid.Column="0">
                                        <TextBlock Text="Vertices"
                                                   FontWeight="SemiBold" />
                                        <TextBlock x:Name="ModelVertexCountTextBlock"
                                                   AutomationProperties.AutomationId="AssetModelVertexCount"
                                                   Style="{StaticResource SectionBodyTextStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1"
                                                Grid.Column="1">
                                        <TextBlock Text="Polygon index entries"
                                                   FontWeight="SemiBold" />
                                        <TextBlock x:Name="ModelPolygonIndexCountTextBlock"
                                                   AutomationProperties.AutomationId="AssetModelPolygonIndexCount"
                                                   Style="{StaticResource SectionBodyTextStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="2"
                                                Grid.Column="0">
                                        <TextBlock Text="Geometry nodes"
                                                   FontWeight="SemiBold" />
                                        <TextBlock x:Name="ModelGeometryCountTextBlock"
                                                   AutomationProperties.AutomationId="AssetModelGeometryCount"
                                                   Style="{StaticResource SectionBodyTextStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="2"
                                                Grid.Column="1">
                                        <TextBlock Text="Materials / textures"
                                                   FontWeight="SemiBold" />
                                        <TextBlock x:Name="ModelMaterialCountTextBlock"
                                                   AutomationProperties.AutomationId="AssetModelMaterialCount"
                                                   Style="{StaticResource SectionBodyTextStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="3"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="2">
                                        <TextBlock Text="UV mapping"
                                                   FontWeight="SemiBold" />
                                        <TextBlock x:Name="ModelUvCountTextBlock"
                                                   AutomationProperties.AutomationId="AssetModelUvCount"
                                                   Style="{StaticResource SectionBodyTextStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="4"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="2">
                                        <TextBlock Text="Material assignment"
                                                   FontWeight="SemiBold" />
                                        <TextBlock x:Name="ModelMaterialLayerCountTextBlock"
                                                   AutomationProperties.AutomationId="AssetModelMaterialLayerCount"
                                                   Style="{StaticResource SectionBodyTextStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="5"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="2">
                                        <TextBlock Text="Texture-material links"
                                                   FontWeight="SemiBold" />
                                        <TextBlock x:Name="ModelConnectionCountTextBlock"
                                                   AutomationProperties.AutomationId="AssetModelConnectionCount"
                                                   Style="{StaticResource SectionBodyTextStyle}" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="ModelTextureLinksTextBlock"
                                           AutomationProperties.AutomationId="AssetModelTextureLinks"
                                           Style="{StaticResource SectionBodyTextStyle}"
                                           TextWrapping="WrapWholeWords"
                                           Text="Texture links appear here when an FBX export references extracted textures." />
                                <Button x:Name="ViewLinkedTextureButton"
                                        AutomationProperties.AutomationId="AssetViewLinkedTextureButton"
                                        Content="View linked texture"
                                        IsEnabled="False"
                                        Visibility="Collapsed"
                                        Click="ViewLinkedTextureButton_Click" />
                            </StackPanel>
                        </Border>
                        <Expander Header="File details"
                                  IsExpanded="False">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Export file"
                                           FontWeight="SemiBold" />
                                <TextBlock x:Name="SelectedExportPathTextBlock"
                                           AutomationProperties.AutomationId="AssetSelectedExportFile"
                                           FontFamily="Consolas"
                                           FontSize="12"
                                           TextWrapping="WrapWholeWords" />
                                <TextBlock Text="Catalog id"
                                           FontWeight="SemiBold" />
                                <TextBlock x:Name="SelectedCatalogIdTextBlock"
                                           AutomationProperties.AutomationId="AssetSelectedCatalogId"
                                           FontFamily="Consolas"
                                           FontSize="12"
                                           TextWrapping="WrapWholeWords" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
