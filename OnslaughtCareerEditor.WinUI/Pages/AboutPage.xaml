<Page
    x:Class="OnslaughtCareerEditor.WinUI.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    AutomationProperties.AutomationId="AboutPageRoot"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <ScrollViewer AutomationProperties.AutomationId="AboutPageScrollViewer"
                  AutomationProperties.Name="About page content">
        <StackPanel Padding="20,18,20,24">
            <TextBlock Text="About Onslaught Toolkit"
                       AutomationProperties.AutomationId="AboutPageTitle"
                       AutomationProperties.HeadingLevel="Level1"
                       Style="{StaticResource SectionTitleTextStyle}" />
            <TextBlock Margin="0,6,0,14"
                       AutomationProperties.AutomationId="AboutProductSummary"
                       Text="A Windows app that keeps Battle Engine Aquila playable. It gets the 2003 game running windowed and widescreen on a modern PC, lets you edit a career save, and opens up its music, cutscenes, and story - without ever touching your installed copy."
                       Style="{StaticResource SectionBodyTextStyle}" />

            <Border Style="{StaticResource SectionCardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="What you can do here"
                               AutomationProperties.AutomationId="AboutCoreCapabilitiesTitle"
                               AutomationProperties.HeadingLevel="Level2"
                               FontSize="18"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Play it properly. Windowed &amp; Mods makes a separate copy of your game, applies a widescreen correction across 28 regions of the executable, and launches it windowed at 1600x900. Optional extras - a subtitle mod, early flight, a local split-screen preset - stay off until you turn them on."
                               Style="{StaticResource SectionBodyTextStyle}" />
                    <TextBlock Text="Edit your career. Save Lab reads a .bes save, shows you what is in it, and writes your changes to a new file - keeping the original size and every byte it does not understand exactly as it found them."
                               Style="{StaticResource SectionBodyTextStyle}" />
                    <TextBlock Text="Hear and read everything. Media plays the soundtrack, voice lines, briefings, and cutscenes straight from your install. Lore is a curated library covering the world, the characters, and how the game was made."
                               Style="{StaticResource SectionBodyTextStyle}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SectionCardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Where this comes from"
                               AutomationProperties.AutomationId="AboutProvenanceTitle"
                               AutomationProperties.HeadingLevel="Level2"
                               FontSize="18"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Battle Engine Aquila was made by Lost Toys and released in 2003. This app is a fan preservation project and has no connection to them."
                               Style="{StaticResource SectionBodyTextStyle}" />
                    <TextBlock Text="Every change it offers was worked out by studying the game itself - reading the original executable, tracing what it does while it runs, and checking each result byte by byte before it ships as an option here. That is why the list of mods is short and why each one says exactly what it does."
                               Style="{StaticResource SectionBodyTextStyle}" />
                    <StackPanel Orientation="Horizontal"
                                Spacing="4">
                        <HyperlinkButton x:Name="AboutProjectLinkButton"
                                         AutomationProperties.AutomationId="AboutProjectLinkButton"
                                         AutomationProperties.Name="Open the project page"
                                         Content="Project page"
                                         NavigateUri="https://github.com/dlprentice/Onslaught-Career-Editor" />
                        <HyperlinkButton x:Name="AboutReleasesLinkButton"
                                         AutomationProperties.AutomationId="AboutReleasesLinkButton"
                                         AutomationProperties.Name="Open the releases page"
                                         Content="Releases"
                                         NavigateUri="https://github.com/dlprentice/Onslaught-Career-Editor/releases" />
                        <HyperlinkButton x:Name="AboutIssuesLinkButton"
                                         AutomationProperties.AutomationId="AboutIssuesLinkButton"
                                         AutomationProperties.Name="Report a problem"
                                         Content="Report a problem"
                                         NavigateUri="https://github.com/dlprentice/Onslaught-Career-Editor/issues" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SectionCardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Project notes"
                               AutomationProperties.AutomationId="AboutProjectNotesTitle"
                               AutomationProperties.HeadingLevel="Level2"
                               FontSize="18"
                               FontWeight="SemiBold" />
                    <TextBlock Text="This app does not include the Battle Engine Aquila game itself. When a workflow needs game data, it reads your configured game install as read-only input."
                               AutomationProperties.AutomationId="AboutGameInstallBoundaryNote"
                               Style="{StaticResource SectionBodyTextStyle}" />
                    <TextBlock Text="Onslaught Toolkit is an unofficial community project. It is not affiliated with or endorsed by the game's publishers or rights holders, and its licenses grant no rights in the retail game or its assets."
                               AutomationProperties.AutomationId="AboutAffiliationBoundaryNote"
                               Style="{StaticResource SectionBodyTextStyle}" />
                    <TextBlock Text="Onslaught Toolkit is free and open source. The source, the technical notes behind every mod, and the contributor setup all live on the project page - and you need none of it to use the app."
                               AutomationProperties.AutomationId="AboutProductLaneNote"
                               Style="{StaticResource SectionBodyTextStyle}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SectionCardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="How your files are handled"
                               AutomationProperties.AutomationId="AboutRetailBehaviorTitle"
                               AutomationProperties.HeadingLevel="Level2"
                               FontSize="18"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Nothing is ever created from scratch. The app edits copies of the files your game already wrote, keeps them the same size, and leaves every byte it does not understand exactly as it found it."
                               Style="{StaticResource SectionBodyTextStyle}" />
                    <TextBlock Text="Your career progress lives in .bes save files; your controls and startup settings live in defaultoptions.bea. Save Lab handles the first, Game Options the second."
                               Style="{StaticResource SectionBodyTextStyle}" />
                    <TextBlock Text="Before any change to a game copy is applied, the app checks the bytes it is about to replace are the ones it expected, and keeps a backup so it can put them back."
                               Style="{StaticResource SectionBodyTextStyle}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SectionCardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Version"
                               AutomationProperties.AutomationId="AboutVersionTitle"
                               AutomationProperties.HeadingLevel="Level2"
                               FontSize="18"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="VersionTextBlock"
                               AutomationProperties.AutomationId="AboutVersionText"
                               Style="{StaticResource SectionBodyTextStyle}"
                               Text="Version: -" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
