{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "onslaught.model-transform-catalog.v2",
  "title": "Selected CMSH parent-relative orientation summary with bounded name identity",
  "description": "Structural JSON validation, including name/status/hash shape. Hash values cannot be verified against unavailable name bytes; counts, parent/key ordinals and frame-range ordering or bounds are not certified.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "generatedRetailDerived", "basis", "meshes"],
  "properties": {
    "schema": {"const": "onslaught.model-transform-catalog.v2"},
    "generatedRetailDerived": {"const": true},
    "basis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coordinates", "classification", "tolerance", "selection", "coverage", "nameInterpretation", "evidence"],
      "properties": {
        "coordinates": {"type": "string"},
        "classification": {"type": "string"},
        "tolerance": {"type": "number", "exclusiveMinimum": 0},
        "selection": {"type": "string"},
        "coverage": {"type": "string"},
        "nameInterpretation": {"type": "string"},
        "evidence": {"type": "string"}
      }
    },
    "meshes": {"type": "array", "minItems": 1, "maxItems": 512, "items": {"$ref": "#/$defs/mesh"}}
  },
  "$defs": {
    "sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$"},
    "nameStatus": {"enum": ["utf8-decoded", "empty", "invalid-utf8", "unterminated"]},
    "nameBytesSha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proper", "reflected", "nonOrthogonal"],
      "properties": {
        "proper": {"type": "integer", "minimum": 0},
        "reflected": {"type": "integer", "minimum": 0},
        "nonOrthogonal": {"type": "integer", "minimum": 0}
      }
    },
    "part": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordinal", "name", "nameStatus", "nameBytesSha256", "parentOrdinal", "hierarchyPoseCount", "virtualFrameCount", "storedKeys",
                   "referencedDistinctKeys", "virtualFrameReferences", "reflectedKeyOrdinals", "reflectedVirtualFrameRanges",
                   "unreferencedKeyCount", "maxRowOrthogonalityError"],
      "oneOf": [
        {"properties": {"nameStatus": {"const": "empty"}, "name": {"const": ""},
                        "nameBytesSha256": {"const": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"}}},
        {"properties": {"nameStatus": {"const": "utf8-decoded"}, "name": {"type": "string", "minLength": 1},
                        "nameBytesSha256": {"$ref": "#/$defs/sha256"}}},
        {"properties": {"nameStatus": {"const": "invalid-utf8"}, "name": {"type": "null"},
                        "nameBytesSha256": {"$ref": "#/$defs/sha256"}}},
        {"properties": {"nameStatus": {"const": "unterminated"}, "name": {"type": "null"},
                        "nameBytesSha256": {"type": "null"}}}
      ],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 0},
        "name": {"type": ["string", "null"]},
        "nameStatus": {"$ref": "#/$defs/nameStatus"},
        "nameBytesSha256": {"$ref": "#/$defs/nameBytesSha256"},
        "parentOrdinal": {"type": ["integer", "null"], "minimum": 0},
        "hierarchyPoseCount": {"type": "integer", "minimum": 1},
        "virtualFrameCount": {"type": "integer", "minimum": 1},
        "storedKeys": {"$ref": "#/$defs/counts"},
        "referencedDistinctKeys": {"$ref": "#/$defs/counts"},
        "virtualFrameReferences": {"$ref": "#/$defs/counts"},
        "reflectedKeyOrdinals": {"type": "array", "items": {"type": "integer", "minimum": 0}},
        "reflectedVirtualFrameRanges": {
          "type": "array", "description": "Inclusive ranges of VHFM positions selecting reflected local keys; not a playback claim.",
          "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 0}}
        },
        "unreferencedKeyCount": {"type": "integer", "minimum": 0},
        "maxRowOrthogonalityError": {"type": "number", "minimum": 0}
      }
    },
    "mesh": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selectionOrdinal", "source", "meshName", "meshNameStatus", "meshNameBytesSha256", "parts", "summary"],
      "oneOf": [
        {"properties": {"meshNameStatus": {"const": "empty"}, "meshName": {"const": ""},
                        "meshNameBytesSha256": {"const": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"}}},
        {"properties": {"meshNameStatus": {"const": "utf8-decoded"}, "meshName": {"type": "string", "minLength": 1},
                        "meshNameBytesSha256": {"$ref": "#/$defs/sha256"}}},
        {"properties": {"meshNameStatus": {"const": "invalid-utf8"}, "meshName": {"type": "null"},
                        "meshNameBytesSha256": {"$ref": "#/$defs/sha256"}}},
        {"properties": {"meshNameStatus": {"const": "unterminated"}, "meshName": {"type": "null"},
                        "meshNameBytesSha256": {"type": "null"}}}
      ],
      "properties": {
        "selectionOrdinal": {"type": "integer", "minimum": 0},
        "source": {
          "type": "object", "additionalProperties": false,
          "required": ["name", "archiveSha256", "inflatedCmshStreamSha256"],
          "properties": {
            "name": {"type": "string"},
            "archiveSha256": {"$ref": "#/$defs/sha256"},
            "inflatedCmshStreamSha256": {"$ref": "#/$defs/sha256",
              "description": "SHA-256 of the complete inflated CMSH stream, including any framed nested siblings."}
          }
        },
        "meshName": {"type": ["string", "null"]},
        "meshNameStatus": {"$ref": "#/$defs/nameStatus"},
        "meshNameBytesSha256": {"$ref": "#/$defs/nameBytesSha256"},
        "parts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/part"}},
        "summary": {
          "type": "object", "additionalProperties": false,
          "required": ["parts", "partsWithStoredReflectedKeys", "partsWithReferencedReflectedKeys",
                       "partsWithNonOrthogonalKeys", "nestedMeshSiblingCandidatesNotAnalysed"],
          "properties": {
            "parts": {"type": "integer", "minimum": 1},
            "partsWithStoredReflectedKeys": {"type": "integer", "minimum": 0},
            "partsWithReferencedReflectedKeys": {"type": "integer", "minimum": 0},
            "partsWithNonOrthogonalKeys": {"type": "integer", "minimum": 0},
            "nestedMeshSiblingCandidatesNotAnalysed": {"type": "integer", "minimum": 0}
          }
        }
      }
    }
  }
}
