{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "onslaught.model-transform-catalog.v1",
  "title": "Selected CMSH parent-relative orientation summary",
  "description": "Structural JSON validation only: cross-field counts, parent/key ordinals and frame-range ordering or bounds are not certified by this schema.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "generatedRetailDerived", "basis", "meshes"],
  "properties": {
    "schema": {"const": "onslaught.model-transform-catalog.v1"},
    "generatedRetailDerived": {"const": true},
    "basis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coordinates", "classification", "tolerance", "selection", "coverage", "evidence"],
      "properties": {
        "coordinates": {"type": "string"},
        "classification": {"type": "string"},
        "tolerance": {"type": "number", "exclusiveMinimum": 0},
        "selection": {"type": "string"},
        "coverage": {"type": "string"},
        "evidence": {"type": "string"}
      }
    },
    "meshes": {"type": "array", "minItems": 1, "maxItems": 512, "items": {"$ref": "#/$defs/mesh"}}
  },
  "$defs": {
    "sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$"},
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proper", "reflected", "nonOrthogonal"],
      "properties": {
        "proper": {"type": "integer", "minimum": 0},
        "reflected": {"type": "integer", "minimum": 0},
        "nonOrthogonal": {"type": "integer", "minimum": 0}
      }
    },
    "part": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordinal", "name", "parentOrdinal", "hierarchyPoseCount", "virtualFrameCount", "storedKeys",
                   "referencedDistinctKeys", "virtualFrameReferences", "reflectedKeyOrdinals", "reflectedVirtualFrameRanges",
                   "unreferencedKeyCount", "maxRowOrthogonalityError"],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 0},
        "name": {"type": "string"},
        "parentOrdinal": {"type": ["integer", "null"], "minimum": 0},
        "hierarchyPoseCount": {"type": "integer", "minimum": 1},
        "virtualFrameCount": {"type": "integer", "minimum": 1},
        "storedKeys": {"$ref": "#/$defs/counts"},
        "referencedDistinctKeys": {"$ref": "#/$defs/counts"},
        "virtualFrameReferences": {"$ref": "#/$defs/counts"},
        "reflectedKeyOrdinals": {"type": "array", "items": {"type": "integer", "minimum": 0}},
        "reflectedVirtualFrameRanges": {
          "type": "array", "description": "Inclusive ranges of VHFM positions selecting reflected local keys; not a playback claim.",
          "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 0}}
        },
        "unreferencedKeyCount": {"type": "integer", "minimum": 0},
        "maxRowOrthogonalityError": {"type": "number", "minimum": 0}
      }
    },
    "mesh": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selectionOrdinal", "source", "meshName", "parts", "summary"],
      "properties": {
        "selectionOrdinal": {"type": "integer", "minimum": 0},
        "source": {
          "type": "object", "additionalProperties": false,
          "required": ["name", "archiveSha256", "inflatedCmshStreamSha256"],
          "properties": {
            "name": {"type": "string"},
            "archiveSha256": {"$ref": "#/$defs/sha256"},
            "inflatedCmshStreamSha256": {"$ref": "#/$defs/sha256",
              "description": "SHA-256 of the complete inflated CMSH stream, including any framed nested siblings."}
          }
        },
        "meshName": {"type": "string"},
        "parts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/part"}},
        "summary": {
          "type": "object", "additionalProperties": false,
          "required": ["parts", "partsWithStoredReflectedKeys", "partsWithReferencedReflectedKeys",
                       "partsWithNonOrthogonalKeys", "nestedMeshSiblingCandidatesNotAnalysed"],
          "properties": {
            "parts": {"type": "integer", "minimum": 1},
            "partsWithStoredReflectedKeys": {"type": "integer", "minimum": 0},
            "partsWithReferencedReflectedKeys": {"type": "integer", "minimum": 0},
            "partsWithNonOrthogonalKeys": {"type": "integer", "minimum": 0},
            "nestedMeshSiblingCandidatesNotAnalysed": {"type": "integer", "minimum": 0}
          }
        }
      }
    }
  }
}
