{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dlprentice/Onslaught-Career-Editor/tools/content_catalog.schema.json",
  "title": "Battle Engine Aquila content catalogue asset record (onslaught.content-catalog.asset.v1)",
  "description": "One line of assets.jsonl written by tools/content_catalog.py. Generated records are retail-derived metadata (names, sizes, hashes) and stay in ignored local-data/. Relationships exist only with evidence; descriptions stay null unless evidenced.",
  "type": "object",
  "required": [
    "schema",
    "id",
    "type",
    "name",
    "source",
    "sha256",
    "sha256Scope",
    "description",
    "relationships",
    "upscale",
    "provenance",
    "generatedRetailDerived"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "onslaught.content-catalog.asset.v1"
    },
    "generatedRetailDerived": {
      "const": true,
      "description": "Marks generated output; tools/public_allowlist_safety_check.py refuses any tracked file carrying it."
    },
    "id": {
      "type": "string",
      "pattern": "^(archive|texture|texture-descriptor|mesh|animation|audio|video|level|level-payload|definition|placement|marker|waypoint-path|script-code|goodie|effect|script|mission-text|text-symbols|text-table|sound-table):.+",
      "description": "Stable id. Files: <type>:<lower-cased install-relative path>; archive members: the container plus #chunk or #ordinal; texture records: name plus a payload-hash prefix; animations: <mesh id>/<ordinal>. Levels: level:NNN; placements: placement:<level>:<world>@<record offset>; definitions: definition:<lower-cased name>; goodies: goodie:NNN; effects: effect:<file>#<ordinal>. Markers: marker:<level>:<world>@<record offset>; waypoint paths: waypoint-path:<level>:<world>#<ordinal>; compiled scripts: script-code:<level>:<world>#<ordinal>."
    },
    "type": {
      "enum": [
        "resource-archive",
        "texture",
        "texture-descriptor",
        "mesh",
        "animation",
        "audio",
        "video",
        "level",
        "level-payload",
        "definition",
        "placement",
        "marker",
        "waypoint-path",
        "script-code",
        "goodie",
        "effect",
        "script",
        "mission-text",
        "text-symbols",
        "text-table",
        "sound-table"
      ]
    },
    "name": {
      "type": "string",
      "description": "The name the data stores (texture/mesh/sample name) or the file stem."
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "container",
        "containerSha256",
        "envelope",
        "offset",
        "chunkPath",
        "length"
      ],
      "properties": {
        "container": {
          "type": "string",
          "description": "Install-relative path of the file holding the asset."
        },
        "containerSha256": {
          "$ref": "#/$defs/sha256"
        },
        "envelope": {
          "type": "string",
          "description": "How the bytes are wrapped, e.g. aya-zlib-members(dds), lvlr-chunk(TEXT)."
        },
        "offset": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Byte offset of the asset inside the decoded container."
        },
        "chunkPath": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "description": "Top-level chunk index (or sample ordinal) in the container."
        },
        "length": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "sha256": {
      "$ref": "#/$defs/sha256"
    },
    "sha256Scope": {
      "type": "string",
      "description": "Which bytes sha256 covers (e.g. inflated DDS file, CMSH stream, TEXT chunk payload)."
    },
    "description": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "evidence"
      ],
      "properties": {
        "text": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationship"
      }
    },
    "referencedBy": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Derived reverse index: mesh ids whose resolved uses-texture links reach this record."
    },
    "loadedByDescriptors": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Derived reverse index (texture files): texture-descriptor ids whose pixels-from link resolves here."
    },
    "upscale": {
      "type": [
        "object",
        "null"
      ],
      "description": "Facts for HD successors and a rule-derived suggestion (textures, meshes, audio, video); null for other types. Never a visual review.",
      "properties": {
        "sourceResolution": {
          "type": "array",
          "items": {
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "storedFormat": {
          "type": [
            "string",
            "null"
          ]
        },
        "sourceFormat": {
          "type": [
            "string",
            "null"
          ],
          "description": "The format the runtime asked for (texture file name)."
        },
        "mipLevels": {
          "type": "integer"
        },
        "alpha": {
          "enum": [
            "none",
            "binary",
            "graded",
            "unknown"
          ]
        },
        "compressed": {
          "type": "boolean"
        },
        "palette": {
          "type": "null",
          "description": "No palettised texture is stored; null until one is found."
        },
        "premultipliedAlpha": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "tiling": {
          "type": "object",
          "required": [
            "status",
            "uvRange",
            "meshes"
          ],
          "properties": {
            "status": {
              "enum": [
                "no-mesh-evidence",
                "within-0-1",
                "repeats-beyond-0-1"
              ]
            },
            "uvRange": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "number"
              },
              "minItems": 4,
              "maxItems": 4
            },
            "meshes": {
              "type": "integer"
            },
            "evidence": {
              "type": "string"
            }
          }
        },
        "suggestedTreatment": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "treatmentBasis": {
          "type": "string"
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "tool",
        "parser",
        "schemaVersion"
      ],
      "properties": {
        "tool": {
          "const": "tools/content_catalog.py"
        },
        "parser": {
          "type": "string"
        },
        "loader": {
          "type": "string",
          "description": "The game function that reads this family (decompilation citation)."
        },
        "schemaVersion": {
          "const": 1
        }
      }
    },
    "archive": {
      "type": "object",
      "required": [
        "kind",
        "members",
        "topLevelChunks",
        "tagCounts",
        "meshChunks"
      ],
      "properties": {
        "kind": {
          "enum": [
            "level",
            "goodie",
            "base",
            "frontend",
            "loading",
            "unknown"
          ]
        },
        "level": {
          "type": "integer"
        },
        "goodie": {
          "type": "integer"
        }
      }
    },
    "texture": {
      "type": "object",
      "required": [
        "status",
        "shelf",
        "frame",
        "width",
        "height",
        "storedFormat",
        "mips",
        "alpha"
      ],
      "properties": {
        "status": {
          "enum": [
            "valid",
            "unsupported",
            "malformed"
          ]
        },
        "sourceFormatFromName": {
          "type": [
            "string",
            "null"
          ]
        },
        "fileNameTruncated": {
          "type": "boolean"
        },
        "mustbe": {
          "type": "boolean"
        },
        "mips": {
          "type": "array",
          "description": "Stored levels in order; ddsOffset and sha256 refer to the encoded level bytes within the inflated DDS, not the compressed AYA or decoded pixels. Older v1 catalogs may omit index, ddsOffset and sha256.",
          "items": {
            "type": "object",
            "required": ["width", "height", "length"],
            "properties": {
              "index": {"type": "integer", "minimum": 0},
              "width": {"type": "integer", "minimum": 1},
              "height": {"type": "integer", "minimum": 1},
              "ddsOffset": {"type": "integer", "minimum": 128},
              "length": {"type": "integer", "minimum": 1},
              "sha256": {"$ref": "#/$defs/sha256"}
            }
          }
        }
      }
    },
    "textureDescriptor": {
      "type": "object",
      "required": [
        "status",
        "occurrences"
      ],
      "properties": {
        "status": {
          "enum": [
            "parsed",
            "unparsed"
          ]
        },
        "occurrences": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "archive",
              "chunk",
              "offset"
            ]
          }
        }
      }
    },
    "mesh": {
      "type": "object",
      "required": [
        "status",
        "parts",
        "vertices",
        "triangles",
        "textures",
        "hierarchy"
      ],
      "properties": {
        "status": {
          "enum": [
            "parsed",
            "partial",
            "unparsed"
          ]
        },
        "hierarchy": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "partRecordSha256": {
                "$ref": "#/$defs/sha256",
                "description": "SHA-256 of the 316-byte CMSP record payload."
              },
              "partPayloadSha256": {
                "$ref": "#/$defs/sha256",
                "description": "SHA-256 of the MESP part payload, without its outer chunk header."
              },
              "storedBounds": {
                "type": "object",
                "additionalProperties": false,
                "required": ["center", "halfExtents", "validFlag", "radius"],
                "description": "Part's stored BBOX before hierarchy or animation transforms; not a world-space or animated bound. The flag is the stored i32, not a validation. Non-finite floats are null.",
                "properties": {
                  "center": {"$ref": "#/$defs/nullableFloat3"},
                  "halfExtents": {"$ref": "#/$defs/nullableFloat3"},
                  "validFlag": {"type": "integer", "minimum": -2147483648, "maximum": 2147483647},
                  "radius": {"type": ["number", "null"]}
                }
              }
            }
          }
        },
        "lodChildParts": {
          "type": "array",
          "items": {"type": ["integer", "null"], "minimum": 0},
          "description": "Immediate child part counts; null means the child could not be parsed."
        },
        "nestedMeshDetails": {
          "type": "array",
          "description": "Immediate nested meshes, including unresolved or unparsed children; this is not a runtime-loading claim.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["relationship", "status", "partCount", "framingPrefixBytes", "payloadSha256", "reason", "scope"],
            "properties": {
              "relationship": {"enum": ["mesh-lod", "mesh-chain", "unresolved-nested-mesh"]},
              "status": {"enum": ["parsed", "partial", "unparsed"]},
              "partCount": {"type": ["integer", "null"], "minimum": 0},
              "framingPrefixBytes": {"type": ["integer", "null"], "minimum": 0},
              "payloadSha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
              "reason": {"type": ["string", "null"]},
              "scope": {"type": "string"}
            }
          }
        },
        "textures": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "slot",
              "name",
              "requestedFormat",
              "uvRange"
            ]
          }
        }
      }
    },
    "animation": {
      "type": "object",
      "required": [
        "mode",
        "startFrame",
        "lastFrame",
        "frameCount",
        "rate",
        "skeleton"
      ]
    },
    "audio": {
      "type": "object",
      "required": [
        "status",
        "role"
      ],
      "properties": {
        "role": {
          "enum": [
            "music",
            "voice",
            "sound-effect"
          ]
        }
      }
    },
    "video": {
      "type": "object",
      "required": [
        "status"
      ]
    },
    "usage": {
      "type": "object",
      "required": [
        "summary",
        "basis"
      ],
      "description": "Derived from this record's resolved relationships: placements, levels, definitions (unit/feature names), meshes, effects, goodies and code sites that use the asset. The basis for HD prioritisation; never a guess.",
      "properties": {
        "summary": {
          "type": "string"
        },
        "basis": {
          "type": "string"
        },
        "placements": {
          "type": "integer"
        },
        "levels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "definitions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "level": {
      "type": "object",
      "required": [
        "resourceArchive",
        "placements"
      ],
      "properties": {
        "worlds": {
          "type": "object",
          "description": "Per world body (BSWD, RLWD): header, timings, counts (CWorld::LoadWorld)."
        },
        "terrain": {
          "type": "object",
          "description": "Decoded ERES (heightfield settings and sample summary, mixer mips, mixer map), SURF and SSHD summaries, and the mixer texture file names the map's set implies."
        }
      }
    },
    "definition": {
      "type": "object",
      "required": [
        "kinds",
        "meshNames"
      ]
    },
    "placement": {
      "type": "object",
      "required": [
        "level",
        "world",
        "definition",
        "position",
        "orientation",
        "kind",
        "thingType",
        "slot"
      ],
      "description": "A WRES thing that names a physics definition (unit, building, squad, feature), decoded in CWorld::LoadWorld's order. slot: its index in LoadWorld's things[] (null when the physics lookup fails and the record takes none)."
    },
    "goodie": {
      "type": "object",
      "required": [
        "number",
        "goodieType"
      ]
    },
    "effect": {
      "type": "object",
      "required": [
        "descriptorType",
        "textures"
      ]
    },
    "payload": {
      "type": "object",
      "required": [
        "tag"
      ],
      "properties": {
        "structure": {
          "type": "string"
        },
        "decoded": {
          "type": "object",
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "enum": [
                "decoded",
                "undecoded",
                "skipped-by-pc-loader"
              ]
            }
          }
        }
      }
    },
    "file": {
      "type": "object",
      "required": [
        "lines"
      ]
    },
    "marker": {
      "type": "object",
      "required": [
        "level",
        "world",
        "kind",
        "thingType",
        "ordinal",
        "slot",
        "position",
        "orientation"
      ],
      "description": "Every other WRES thing (waypoint, spawner, level-script, safe-side, start, spawn-point, sphere-trigger, wingman-start, hazard, ...): its init record (CInitThing::Load and the subclass's fields).",
      "properties": {
        "kind": {
          "type": "string"
        },
        "slot": {
          "type": [
            "integer",
            "null"
          ]
        },
        "position": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        }
      }
    },
    "waypointPath": {
      "type": "object",
      "required": [
        "level",
        "world",
        "ordinal",
        "members",
        "waypoints",
        "ignoredByLoader"
      ],
      "description": "A CWaypointPath: its member indices are slots of LoadWorld's things[]; members that are not waypoints are dropped by the loader (path-member relationships list the kept ones in order)."
    },
    "scriptCode": {
      "type": "object",
      "required": [
        "level",
        "world",
        "ordinal",
        "instructions",
        "symbols",
        "nativeCalls",
        "objectives",
        "textIds",
        "units",
        "argumentRule"
      ],
      "description": "A compiled mission script from a world body (CWorld::LoadScripts): counts, the natives it calls and the literal arguments of those calls by role (text ids, units, waypoint paths, thing names, scripts, events)."
    }
  },
  "$defs": {
    "nullableFloat3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"type": ["number", "null"]}
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "source",
        "rule"
      ],
      "properties": {
        "kind": {
          "enum": [
            "loader-code",
            "data"
          ],
          "description": "loader-code: a function in the public decompilation decides the link; data: the bytes themselves state it."
        },
        "source": {
          "type": "string"
        },
        "rule": {
          "type": "string"
        }
      }
    },
    "relationship": {
      "type": "object",
      "required": [
        "type",
        "target",
        "status",
        "evidence"
      ],
      "properties": {
        "type": {
          "enum": [
            "resources-of-level",
            "loads-mesh",
            "loaded-by-archive",
            "pixels-from",
            "uses-texture",
            "has-animation",
            "animates",
            "briefing-for-level",
            "imposter-of-mesh",
            "shows-texture",
            "shows-mesh",
            "plays-video",
            "opens-level",
            "instance-of",
            "uses-mesh",
            "script-source",
            "named-by-code",
            "resources",
            "world-header",
            "same-name-as-mesh-slot",
            "same-name-other-shelf",
            "briefing-video",
            "runs-script",
            "sets-script",
            "compiled-from",
            "compiled-as",
            "uses-text",
            "spawns-unit",
            "follows-path",
            "names-thing",
            "path-member",
            "texture-by-rule"
          ]
        },
        "target": {
          "type": [
            "string",
            "null"
          ],
          "description": "An id of a record in the same catalogue (never an absent id), or null when unresolved or several targets apply (then targets lists them)."
        },
        "targets": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "status": {
          "enum": [
            "resolved",
            "resolved-per-archive",
            "unresolved",
            "unresolved-in-loading-archives",
            "name-match",
            "name-match-unloaded",
            "code-site",
            "code-rule"
          ],
          "description": "name-match: a stored string equals a file name but no loader joins them; name-match-unloaded: a data observation about content no retail loader reads; code-site: a literal lookup in game code (the evidence names the site); code-rule: a name game code builds with sprintf from a format rule and data (the evidence names the function and the rule). name-match also covers a script argument that equals a thing's name."
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    }
  }
}
