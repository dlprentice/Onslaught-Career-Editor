<Project Sdk="Godot.NET.Sdk/4.8.0-dev.6">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RuntimeFrameworkVersion>8.0.30</RuntimeFrameworkVersion>
    <RootNamespace>OnslaughtToolkit.Companion</RootNamespace>
    <AssemblyName>OnslaughtToolkit.Godot</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Deterministic>true</Deterministic>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreEnablePackagePruning>true</RestoreEnablePackagePruning>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Careers/**/*.cs;Files/**/*.cs;Game/**/*.cs;Media/**/*.cs;Ui/**/*.cs" />
    <!-- Contract tests and development entries (captures, license metadata) never enter a release export. -->
    <Compile Include="Tests/**/*.cs;Development/**/*.cs" Condition="'$(Configuration)' != 'ExportRelease'" />
    <!-- Share the existing safety implementation unchanged, without the AppCore codec or services. -->
    <Compile Include="../../OnslaughtCareerEditor.AppCore/SaveLabFileTransaction.cs" Link="Safety/SaveLabFileTransaction.cs" />
    <Compile Include="../../OnslaughtCareerEditor.AppCore/FileMutationSafety.cs" Link="Safety/FileMutationSafety.cs" />
    <!-- Pure MIT readers linked unchanged: the game's text table and the Goodie unlock rules. -->
    <Compile Include="../../OnslaughtCareerEditor.AppCore/GameTextCatalog.cs" Link="Linked/GameTextCatalog.cs" />
    <Compile Include="../../OnslaughtCareerEditor.AppCore/GoodieUnlockRequirementService.cs" Link="Linked/GoodieUnlockRequirementService.cs" />
  </ItemGroup>
</Project>
