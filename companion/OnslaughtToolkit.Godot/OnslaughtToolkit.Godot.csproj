<Project Sdk="Godot.NET.Sdk/4.8.0-dev.6">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RuntimeFrameworkVersion>8.0.30</RuntimeFrameworkVersion>
    <RootNamespace>OnslaughtToolkit.Companion</RootNamespace>
    <AssemblyName>OnslaughtToolkit.Godot</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Deterministic>true</Deterministic>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreEnablePackagePruning>true</RestoreEnablePackagePruning>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <!-- SaveLab.cs is retained migration reference, never compiled into this app. -->
    <Compile Include="io/ProtectedSaveFiles.cs" />
    <Compile Include="io/SafetyCompatibility.cs" />
    <!-- Share the existing safety implementation without the AppCore codec/services. -->
    <Compile Include="../../OnslaughtCareerEditor.AppCore/SaveLabFileTransaction.cs" Link="Safety/SaveLabFileTransaction.cs" />
    <Compile Include="../../OnslaughtCareerEditor.AppCore/FileMutationSafety.cs" Link="Safety/FileMutationSafety.cs" />
  </ItemGroup>
</Project>
