; MIT companion application. No retail assets or GPL rebuild dependencies.
config_version=5

[application]
config/name="Onslaught Toolkit"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.8", "C#", "GL Compatibility")
config/use_custom_user_dir=true
config/custom_user_dir_name="OnslaughtToolkit"

[dotnet]
project/assembly_name="OnslaughtToolkit.Godot"

[display]
window/size/viewport_width=1180
window/size/viewport_height=850
window/size/window_width_override=1180
window/size/window_height_override=850
window/size/resizable=true
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.043, 0.063, 0.09, 1)
