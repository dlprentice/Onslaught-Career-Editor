<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RuntimeFrameworkVersion>8.0.30</RuntimeFrameworkVersion>
    <AssemblyName>OnslaughtToolkit.FileBridge</AssemblyName>
    <RootNamespace>OnslaughtToolkit.FileBridge</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="Compatibility.cs" />
    <!-- Keep the existing safety implementation authoritative and unchanged. -->
    <Compile Include="../../OnslaughtCareerEditor.AppCore/SaveLabFileTransaction.cs" Link="Safety/SaveLabFileTransaction.cs" />
    <Compile Include="../../OnslaughtCareerEditor.AppCore/FileMutationSafety.cs" Link="Safety/FileMutationSafety.cs" />
  </ItemGroup>
</Project>
