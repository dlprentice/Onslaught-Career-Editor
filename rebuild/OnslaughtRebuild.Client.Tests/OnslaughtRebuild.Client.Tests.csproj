<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>OnslaughtRebuild.Client.Tests</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OnslaughtRebuild.Client\OnslaughtRebuild.Client.csproj" />
    <ProjectReference Include="..\OnslaughtRebuild.Core\OnslaughtRebuild.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\TestSupport\Level100TestActorDefinitions.cs"
             Link="TestSupport\Level100TestActorDefinitions.cs" />
    <Compile Include="..\OnslaughtRebuild.Godot\Level100AudioCatalog.cs"
             Link="godot-audio-source\Level100AudioCatalog.cs" />
    <Compile Include="..\OnslaughtRebuild.Godot\Level100HudPresentation.cs"
             Link="godot-hud-source\Level100HudPresentation.cs" />
    <Compile Include="..\OnslaughtRebuild.Godot\Level100MessagePlaybackState.cs"
             Link="godot-hud-source\Level100MessagePlaybackState.cs" />
    <Compile Include="..\OnslaughtRebuild.Godot\Level100MessageSchedule.cs"
             Link="godot-hud-source\Level100MessageSchedule.cs" />
    <Compile Include="..\OnslaughtRebuild.Godot\Level100TerrainCompositor.cs"
             Link="godot-terrain-source\Level100TerrainCompositor.cs" />
    <!-- The deterministic half of the cold-start media lane. Both files are
         deliberately free of Godot types so the sequence can be tested without
         an engine: the capture rig suppresses the intro (as retail's -skipfmv
         does), so these tests are the only thing standing between the intro
         path and silent rot. -->
    <Compile Include="..\OnslaughtRebuild.Godot\RetailStartupSchedule.cs"
             Link="godot-startup-source\RetailStartupSchedule.cs" />
    <Compile Include="..\OnslaughtRebuild.Godot\RetailStartupMediaIndex.cs"
             Link="godot-startup-source\RetailStartupMediaIndex.cs" />
    <!-- CFEPIntro this+0x18 clock. Godot-free so the click-to-start prompt
         blink can be pinned without an engine; DrawClickToStart is the consumer. -->
    <Compile Include="..\OnslaughtRebuild.Godot\RetailClickToStartPrompt.cs"
             Link="godot-startup-source\RetailClickToStartPrompt.cs" />
    <Compile Include="..\OnslaughtRebuild.Godot\RetailClickToStartTitle.cs"
             Link="godot-startup-source\RetailClickToStartTitle.cs" />
    <Compile Include="..\OnslaughtRebuild.Godot\RetailClickToStartSlide.cs"
             Link="godot-startup-source\RetailClickToStartSlide.cs" />
    <Compile Include="..\OnslaughtRebuild.Godot\RetailClickToStartGlyphs.cs"
             Link="godot-startup-source\RetailClickToStartGlyphs.cs" />
    <Compile Include="..\OnslaughtRebuild.Godot\RetailClickToStartSplash.cs"
             Link="godot-startup-source\RetailClickToStartSplash.cs" />
    <Compile Include="..\OnslaughtRebuild.Godot\RetailAttractLoop.cs"
             Link="godot-startup-source\RetailAttractLoop.cs" />
    <Compile Include="..\OnslaughtRebuild.Godot\RetailFmvSkip.cs"
             Link="godot-startup-source\RetailFmvSkip.cs" />
    <Compile Include="..\OnslaughtRebuild.Godot\RetailClickToStartInput.cs"
             Link="godot-startup-source\RetailClickToStartInput.cs" />
    <Compile Include="..\OnslaughtRebuild.Godot\RetailClickToStartOverlay.cs"
             Link="godot-startup-source\RetailClickToStartOverlay.cs" />
    <Compile Include="..\OnslaughtRebuild.Godot\RetailClickToStartProcess.cs"
             Link="godot-startup-source\RetailClickToStartProcess.cs" />
    <Compile Include="..\OnslaughtRebuild.Godot\RetailClickToStartProcessHead.cs"
             Link="godot-startup-source\RetailClickToStartProcessHead.cs" />
    <Compile Include="..\OnslaughtRebuild.Godot\RetailMainMenuHitTest.cs"
             Link="godot-startup-source\RetailMainMenuHitTest.cs" />
    <Compile Include="..\OnslaughtRebuild.Godot\RetailFrontendCursor.cs"
             Link="godot-startup-source\RetailFrontendCursor.cs" />
    <Compile Include="..\OnslaughtRebuild.Godot\RetailFeMessBox.cs"
             Link="godot-startup-source\RetailFeMessBox.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\OnslaughtRebuild.Client\**\*.cs"
             Exclude="..\OnslaughtRebuild.Client\bin\**;..\OnslaughtRebuild.Client\obj\**"
             Link="client-source\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\OnslaughtRebuild.Client\OnslaughtRebuild.Client.csproj"
             Link="client-project\OnslaughtRebuild.Client.csproj"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\OnslaughtRebuild.Godot\Assets\Level100\StaticWorld\level100-static-world.json"
             Link="Assets\Level100\StaticWorld\level100-static-world.json"
             CopyToOutputDirectory="Always" />
    <Content Include="..\OnslaughtRebuild.Godot\Assets\Level100\StaticWorld\level100-static-world-animation.json"
             Link="Assets\Level100\StaticWorld\level100-static-world-animation.json"
             CopyToOutputDirectory="Always" />
    <Content Include="..\OnslaughtRebuild.Godot\FirstFlightHud.cs"
             Link="godot-hud-layout-source\FirstFlightHud.cs"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\OnslaughtRebuild.Godot\FirstFlightGame.cs"
             Link="godot-pause-source\FirstFlightGame.cs"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\OnslaughtRebuild.Godot\RetailFrontendFlow.cs"
             Link="godot-pause-source\RetailFrontendFlow.cs"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\OnslaughtRebuild.Godot\RetailFrontendFlow.Cursor.cs"
             Link="godot-pause-source\RetailFrontendFlow.Cursor.cs"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\OnslaughtRebuild.Godot\RetailStartupSequence.cs"
             Link="godot-pause-source\RetailStartupSequence.cs"
             CopyToOutputDirectory="PreserveNewest" />
    <!-- FEP_OPTIONS lives in a partial. RetailFrontendPageFillEvidenceTests has
         to see its page renderer too, because the "the frontend is showing the
         raw D3D clear colour" reading of #147 named the options root by name. -->
    <Content Include="..\OnslaughtRebuild.Godot\RetailFrontendFlow.Options.cs"
             Link="godot-pause-source\RetailFrontendFlow.Options.cs"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\OnslaughtRebuild.Godot\FirstFlightPauseMenu.cs"
             Link="godot-pause-source\FirstFlightPauseMenu.cs"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\OnslaughtRebuild.Godot\Level100Audio.cs"
             Link="godot-pause-source\Level100Audio.cs"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\tools\materialize_retail_assets.py"
             Link="godot-pause-source\materialize_retail_assets.py"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\OnslaughtRebuild.Godot\Level100WaterAsset.cs"
             Link="godot-water-source\Level100WaterAsset.cs"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\OnslaughtRebuild.Godot\Level100SunAsset.cs"
             Link="godot-sun-source\Level100SunAsset.cs"
             CopyToOutputDirectory="PreserveNewest" />
    <!-- ParticleQuadSizeConventionTests reads the effect construction sites to
         check every sprite size is an authored Radius taken through the one
         owner. It cannot instantiate the Godot type, so it asserts on source. -->
    <Content Include="..\OnslaughtRebuild.Godot\FirstFlightWorldView.cs"
             Link="godot-effects-source\FirstFlightWorldView.cs"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
