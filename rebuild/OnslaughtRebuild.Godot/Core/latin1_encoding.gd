static func encode(value: Variant) -> Dictionary:
	var admitted: Dictionary = Text.units(value)
	if not admitted.ok:
		return admitted
	if admitted.value == null:
		return {"ok": false, "error_type": "ArgumentNullException", "parameter": "s", "error": "Latin-1 input cannot be null."}
	var units: PackedInt32Array = admitted.value
	var result := PackedByteArray()
	result.resize(units.size())
	for index: int in range(units.size()):
		var unit: int = units[index]
		# The legacy best-fit fallback emits one byte per UTF-16 unit, including
		# two '?' bytes for a valid surrogate pair. Do not scalar-decode it.
		result[index] = unit if unit <= 255 else BEST_FIT.get(unit, 63)
	return {"ok": true, "value": result}


static func decode(bytes: PackedByteArray) -> PackedInt32Array:
	var result := PackedInt32Array()
	result.resize(bytes.size())
	for index: int in range(bytes.size()):
		result[index] = bytes[index]
	return result
